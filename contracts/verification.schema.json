{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/verification.schema.json",
  "title": "Verification: whether a candidate patch is accepted, decided outside the fixer's reach",
  "description": "accept only if every check passes; any fail rejects; anything else needs review. Passing means the candidate passed this suite, not that the game is correct.",
  "type": "object",
  "required": [
    "format",
    "candidate",
    "evaluator",
    "checks",
    "decision",
    "reasons"
  ],
  "properties": {
    "format": {
      "enum": ["expectrail.verification/v0", "nightshift.verification/v0"]
    },
    "candidate": {
      "type": "object",
      "required": [
        "patchSha256",
        "baseTree",
        "attempt"
      ],
      "properties": {
        "patchSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseTree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "request": {
          "type": "string"
        },
        "requestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the repair-request document that produced this verification"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spec",
          "kind",
          "route",
          "result"
        ],
        "properties": {
          "spec": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "regression",
              "gameplay",
              "held-out",
              "clean"
            ]
          },
          "route": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "needs-review"
            ]
          },
          "verdictSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "needs-review"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suite": {
      "type": "object",
      "description": "Optional provenance for candidate/clean/held-out observation sources (not required on early rejects). When present, all three arms are required.",
      "required": ["candidate", "clean", "heldOut"],
      "properties": {
        "candidate": { "$ref": "#/$defs/suiteArm" },
        "clean": { "$ref": "#/$defs/suiteArm" },
        "heldOut": { "$ref": "#/$defs/suiteArm" },
        "earlyReject": {
          "type": "object",
          "required": ["gate", "detail"],
          "additionalProperties": false,
          "properties": {
            "gate": {
              "enum": ["editable-globs", "base-tree"]
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "suiteArm": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "harness",
            "fixture",
            "fixture-fallback",
            "interim-fixture",
            "unavailable",
            "path",
            "not-run"
          ]
        },
        "path": { "type": "string" },
        "observationsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detail": { "type": "string" }
      }
    }
  }
}

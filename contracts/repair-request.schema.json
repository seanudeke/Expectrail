{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/expectrail/contracts/repair-request.schema.json",
  "title": "Repair request: everything the fixer gets, and nothing it should not",
  "description": "No held-out cases, no evaluator code, no thresholds beyond the failing spec, no keys.",
  "type": "object",
  "required": [
    "format",
    "id",
    "base",
    "editable",
    "failing",
    "budget"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "enum": ["expectrail.repair-request/v0"]
    },
    "id": {
      "type": "string"
    },
    "base": {
      "type": "object",
      "required": [
        "tree"
      ],
      "properties": {
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "path globs the fixer may change, relative to the game directory"
    },
    "failing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "spec",
          "verdict",
          "route"
        ],
        "properties": {
          "spec": {
            "type": "object"
          },
          "verdict": {
            "type": "object"
          },
          "route": {
            "type": "object"
          },
          "keyFrames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "minutesPerAttempt": {
          "type": "number"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "description": "Optional provenance for how the bug report / repair-request was drafted",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string"
        }
      }
    }
  }
}

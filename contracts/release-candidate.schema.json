{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/seanudeke/nightshift/contracts/release-candidate.schema.json",
  "title": "Release candidate: signed pointer to a verification decision",
  "description": "Verifier-host adjunct written by the morning report. Ed25519 signatures; private key stays off the fixer host. publicKey is the published half.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "verificationSha256",
    "decision",
    "signature",
    "signingKey",
    "candidatePatchSha256",
    "algorithm",
    "publicKey"
  ],
  "properties": {
    "format": {
      "const": "nightshift.release-candidate/v0"
    },
    "verificationSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decision": {
      "enum": ["accept", "reject", "needs-review"]
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "signingKey": {
      "type": "string",
      "minLength": 1,
      "description": "Path note for the private key on the verifier host (never the raw private bytes)."
    },
    "algorithm": {
      "const": "ed25519"
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "description": "Base64 raw Ed25519 public key (32 bytes)."
    },
    "candidatePatchSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

# A theme change leaves the primary button's colours transparent: the button is there and clickable, but nothing is drawn.
diff -ruN a/checkout/checkout.css b/checkout/checkout.css
--- a/checkout/checkout.css
+++ b/checkout/checkout.css
@@ -1,3 +1,9 @@
 .container {
   max-width: 960px;
 }
+
+.btn-primary {
+  --bs-btn-bg: transparent;
+  --bs-btn-border-color: transparent;
+  --bs-btn-color: transparent;
+}

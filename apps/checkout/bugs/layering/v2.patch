# The same promo bar covers the checkout button, but lets clicks through (pointer-events: none): a script can still click the button, a shopper cannot see it.
diff -ruN a/checkout/checkout.css b/checkout/checkout.css
--- a/checkout/checkout.css
+++ b/checkout/checkout.css
@@ -1,3 +1,15 @@
 .container {
   max-width: 960px;
 }
+
+.promo-bar {
+  position: relative;
+  z-index: 2;
+  margin-top: -52px;
+  padding: 1rem;
+  text-align: center;
+  background: #fff3cd;
+  border: 1px solid #ffe69c;
+  border-radius: .5rem;
+  pointer-events: none;
+}
diff -ruN a/checkout/index.html b/checkout/index.html
--- a/checkout/index.html
+++ b/checkout/index.html
@@ -495,6 +495,7 @@
               <button class="w-100 btn btn-primary btn-lg" type="submit">
                 Continue to checkout
               </button>
+              <div class="promo-bar">Free shipping on orders over $50</div>
             </form>
           </div>
         </div>
